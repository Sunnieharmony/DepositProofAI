# Copy this file to .env and add a Google AI Studio API key.
# Do not commit .env or paste its contents into chat.
GEMINI_API_KEY=
LLM_PROVIDER=google
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Hugging Face fallback. Set LLM_PROVIDER=huggingface and add HF_TOKEN
# if you want to use the Hugging Face Inference Providers router instead.
HF_TOKEN=
HF_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_LLM_MODEL=google/gemma-2-2b-it

# Optional: local semantic retrieval. Without this package, clause search uses
# a labelled keyword fallback. Installing it downloads the model on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Image limits and hosted request timeouts.
MAX_IMAGE_MB=12
IMAGE_MAX_SIDE=768
VLM_TIMEOUT=90
LLM_TIMEOUT=60
